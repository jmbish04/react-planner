# Cloudflare Configuration
# Copy this file to .dev.vars for local development

# Your Cloudflare Account ID (find in dashboard)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare Images API Token (create in dashboard)
# This should be set as a secret: wrangler secret put IMAGES_API_TOKEN
# IMAGES_API_TOKEN=your_images_api_token_here

# D1 Database ID (automatically generated when you create the database)
# Update this in wrangler.jsonc after running: wrangler d1 create colby_floorplan_db
# DATABASE_ID=00000000-0000-0000-0000-000000000000
