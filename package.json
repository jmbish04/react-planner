{
    "name": "smart-architect",
    "version": "1.0.0",
    "description": "Smart Architect Dashboard with React Planner and Gemini",
    "main": "src/index.js",
    "scripts": {
        "start": "webpack-dev-server --inline --config webpack.config.js --port 9001 --mode development",
        "build:canvas": "webpack --config webpack.config.js --mode production",
        "build:chat": "cd chat && npm run build",
        "build:docs": "mkdir -p dist/docs && cp -R docs-site/. dist/docs/",
        "build": "rm -rf dist && npm run build:canvas && npm run build:chat && npm run build:docs",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply smart-architect-db --local",
        "db:migrate:remote": "wrangler d1 migrations apply smart-architect-db --remote",
        "types": "wrangler types",
        "dev": "wrangler dev",
        "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
        "pretest": "lsof -ti:9001 | xargs kill -9 || true",
        "test": "npm run pretest && npx playwright test"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.81",
        "@cloudflare/ai-chat": "^0.7.2",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@resvg/resvg-wasm": "^2.6.2",
        "agents": "^0.13.3",
        "ai": "^6.0.193",
        "area-polygon": "^1.0.1",
        "babel-polyfill": "^6.26.0",
        "convert-units": "^2.3.4",
        "create-react-class": "^15.7.0",
        "immutable": "^3.8.2",
        "immutablediff": "^0.4.4",
        "immutablepatch": "^0.5.0",
        "polylabel": "^2.0.1",
        "prop-types": "^15.7.2",
        "react": "^16.14.0",
        "react-container-dimensions": "^1.4.1",
        "react-dom": "^16.14.0",
        "react-icons": "^5.5.0",
        "react-redux": "^5.1.1",
        "react-svg-pan-zoom": "^3.13.1",
        "react-tabs": "^3.0.0",
        "redux": "^4.0.1",
        "regenerator-runtime": "^0.14.1",
        "shortid": "^2.2.17",
        "three": "^0.94.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260601.1",
        "@playwright/test": "^1.57.0",
        "babel-cli": "^6.26.0",
        "babel-core": "^6.26.3",
        "babel-loader": "^7.1.5",
        "babel-plugin-import-glob": "^2.0.0",
        "babel-plugin-transform-class-properties": "^6.24.1",
        "babel-plugin-transform-object-rest-spread": "^6.26.0",
        "babel-preset-env": "^1.7.0",
        "babel-preset-react": "^6.24.1",
        "cross-env": "^5.2.0",
        "css-loader": "^2.1.1",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "file-loader": "^3.0.1",
        "html-webpack-plugin": "^3.2.0",
        "style-loader": "^0.23.1",
        "typescript": "^5.9.3",
        "webpack": "^4.29.6",
        "webpack-cli": "^3.3.0",
        "webpack-dev-server": "^3.7.1",
        "wrangler": "^4.97.0"
    }
}
